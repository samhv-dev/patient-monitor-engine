{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pme-formulary/1",
  "title": "The formulary layer (plan learner-action-remote.md §5)",
  "description": "One file per drug (<drugId>.json) and per diluent (diluents/<id>.json), sources.json, pending.json and stock-syringes.json (the pump rack's stock, plan pump-rack-tci.md S1). Every number sits in an object with a src (a key into sources.json) or is a gap naming an owner question. The source rules beyond shape are in packages/controller/src/formulary/load.ts (checkFormulary).",
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]*$" },
    "src": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "gap": { "type": "string", "pattern": "^LQ(1[0-4]|[1-9])$" },
    "has": {
      "type": "object", "additionalProperties": false, "required": ["stabilis", "trissel", "monograph"],
      "properties": { "stabilis": { "type": "boolean" }, "trissel": { "type": "boolean" }, "monograph": { "type": "boolean" } }
    },
    "crossCheck": {
      "type": "object", "additionalProperties": false, "required": ["trissel"],
      "properties": {
        "trissel": { "enum": ["agrees", "differs", "not listed"] },
        "src": { "$ref": "#/definitions/src" },
        "ruling": {
          "type": "object", "additionalProperties": false, "required": ["by", "date", "follows"],
          "properties": { "by": { "$ref": "#/definitions/text" }, "date": { "$ref": "#/definitions/date" }, "follows": { "enum": ["stabilis", "trissel", "monograph"] } }
        }
      }
    },
    "verdict": { "enum": ["incompatible", "compatible", "conditional", "not tested"] },
    "concentration": {
      "description": "The concentration a stability row was measured at, as its source states it: amount, or amount to max for a stated range; per mL or per L.",
      "type": "object", "additionalProperties": false, "required": ["amount", "unit", "src"],
      "properties": {
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "pattern": "^(g|mg|mcg|µg|ng|IU|units|mmol|mEq)/(mL|L)$" },
        "src": { "$ref": "#/definitions/src" }
      }
    },
    "inUse": {
      "description": "A label's in-use time: how long the label allows the prepared product, the temperature it names (the upper end of a range; absent when the label names none) and the label's own condition in our words.",
      "type": "object", "additionalProperties": false, "required": ["h", "condition", "src"],
      "properties": {
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "tempC": { "type": "number" },
        "condition": { "$ref": "#/definitions/text" },
        "src": { "$ref": "#/definitions/src" }
      }
    },
    "compat": {
      "type": "object", "additionalProperties": false, "required": ["verdict", "statement", "src", "crossCheck"],
      "properties": { "verdict": { "$ref": "#/definitions/verdict" }, "statement": { "$ref": "#/definitions/text" }, "src": { "$ref": "#/definitions/src" }, "crossCheck": { "$ref": "#/definitions/crossCheck" } }
    },
    "product": {
      "type": "object", "additionalProperties": false, "required": ["id", "form", "strength"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "form": { "enum": ["powder", "solution", "emulsion"] },
        "strength": {
          "type": "object", "additionalProperties": false, "required": ["amount", "unit", "perVial", "src"],
          "properties": { "amount": { "type": "number", "exclusiveMinimum": 0 }, "unit": { "type": "string", "minLength": 1 }, "perVial": { "type": "boolean" }, "src": { "$ref": "#/definitions/src" } }
        },
        "reconstitute": {
          "type": "object", "additionalProperties": false, "required": ["diluents", "volumeMl", "src"],
          "properties": { "diluents": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/id" } }, "volumeMl": { "type": "number", "exclusiveMinimum": 0 }, "src": { "$ref": "#/definitions/src" } }
        },
        "prepTime": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["s", "src"], "properties": { "s": { "type": "number", "minimum": 0 }, "src": { "$ref": "#/definitions/src" } } },
            { "type": "object", "additionalProperties": false, "required": ["gap"], "properties": { "gap": { "$ref": "#/definitions/gap" } } }
          ]
        },
        "inUse": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/inUse" } }
      }
    },
    "drug": {
      "type": "object", "additionalProperties": false, "required": ["drugId", "products", "diluents", "admixtures", "stability", "has"],
      "properties": {
        "$comment": { "type": "string" },
        "drugId": { "$ref": "#/definitions/id" },
        "products": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/product" } },
        "diluents": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "listed", "src"],
            "properties": { "id": { "$ref": "#/definitions/id" }, "listed": { "type": "boolean" }, "src": { "$ref": "#/definitions/src" }, "compat": { "$ref": "#/definitions/compat" } }
          }
        },
        "admixtures": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["with", "verdict", "statement", "src", "crossCheck"],
            "properties": { "with": { "$ref": "#/definitions/id" }, "verdict": { "$ref": "#/definitions/verdict" }, "statement": { "$ref": "#/definitions/text" }, "src": { "$ref": "#/definitions/src" }, "crossCheck": { "$ref": "#/definitions/crossCheck" } }
          }
        },
        "stability": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["diluent", "container", "tempC", "points", "statement", "src", "crossCheck"],
            "properties": {
              "kind": { "description": "'stable': the source states 'stable for T' (points [[T, x]]: at least x retained up to T h); absent or 'measured': measured fractions.", "enum": ["measured", "stable"] },
              "diluent": { "$ref": "#/definitions/id" },
              "concentration": { "$ref": "#/definitions/concentration" },
              "container": { "enum": ["vial", "syringe-pp", "bag-pvc", "bag-polyolefin"] },
              "tempC": { "type": "number" },
              "points": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0 } } },
              "statement": { "$ref": "#/definitions/text" },
              "src": { "$ref": "#/definitions/src" },
              "crossCheck": { "$ref": "#/definitions/crossCheck" }
            }
          }
        },
        "has": { "$ref": "#/definitions/has" }
      }
    },
    "diluent": {
      "type": "object", "additionalProperties": false, "required": ["diluentId", "name", "has"],
      "properties": {
        "$comment": { "type": "string" },
        "diluentId": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "content": {
          "type": "object", "additionalProperties": false, "required": ["amount", "unit", "src"],
          "properties": { "amount": { "type": "number", "minimum": 0 }, "unit": { "type": "string", "minLength": 1 }, "src": { "$ref": "#/definitions/src" } }
        },
        "has": { "$ref": "#/definitions/has" }
      }
    },
    "sources": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "id", "retrieved", "cites"], "properties": { "kind": { "const": "stabilis" }, "id": { "type": "string", "minLength": 1 }, "retrieved": { "$ref": "#/definitions/date" }, "cites": { "$ref": "#/definitions/text" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "edition", "monograph", "page", "reader", "date"], "properties": { "kind": { "const": "trissel" }, "edition": { "const": "17 (2013)" }, "monograph": { "$ref": "#/definitions/text" }, "page": { "type": ["integer", "string"], "minimum": 1, "minLength": 1 }, "reader": { "$ref": "#/definitions/text" }, "date": { "$ref": "#/definitions/date" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "product", "holder", "version", "issuer"], "properties": { "kind": { "const": "monograph" }, "product": { "$ref": "#/definitions/text" }, "holder": { "$ref": "#/definitions/text" }, "version": { "$ref": "#/definitions/text" }, "issuer": { "enum": ["DailyMed", "EMC", "department"] } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "citation"], "properties": { "kind": { "const": "study" }, "citation": { "$ref": "#/definitions/text" }, "doi": { "type": "string" }, "pmid": { "type": "string" } } }
        ]
      }
    },
    "pending": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "stockItem": {
      "description": "A product at its labelled strength, ready to load on a pump channel (plan pump-rack-tci.md S1, PQ7 = B): the drug file and product it is, the volume it holds and the label's use at that strength, both from the product's own monograph.",
      "type": "object", "additionalProperties": false, "required": ["id", "drugId", "product", "volumeMl", "use"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "drugId": { "$ref": "#/definitions/id" },
        "product": { "$ref": "#/definitions/id" },
        "volumeMl": {
          "type": "object", "additionalProperties": false, "required": ["ml", "src"],
          "properties": { "ml": { "type": "number", "exclusiveMinimum": 0 }, "src": { "$ref": "#/definitions/src" } }
        },
        "use": {
          "type": "object", "additionalProperties": false, "required": ["statement", "src"],
          "properties": { "statement": { "$ref": "#/definitions/text" }, "src": { "$ref": "#/definitions/src" } }
        }
      }
    },
    "stock": {
      "description": "stock-syringes.json: the syringes and the bags a pump channel can take from stock.",
      "type": "object", "additionalProperties": false, "required": ["syringes", "bags"],
      "properties": {
        "$comment": { "type": "string" },
        "syringes": { "type": "array", "items": { "$ref": "#/definitions/stockItem" } },
        "bags": { "type": "array", "items": { "$ref": "#/definitions/stockItem" } }
      }
    }
  }
}
