{
  "schema": "pme-scenario/1",
  "id": "showcase-tamponade",
  "title": "Stab wound: tamponade, PEA and pericardiocentesis",
  "category": "Showcase",
  "durationMin": 15,
  "story": "A 30-year-old man with a stab wound to the left chest. He arrives tachycardic, with a narrow pulse pressure and a raised CVP; blood is collecting in the pericardium. Without drainage he loses his pulse (PEA) about 8 minutes after arrival. CPR alone cannot bring him back; pericardiocentesis during good CPR brings the pulse back about a minute and a half later.",
  "objectives": [
    "Name the tamponade within 180 s of arrival from the monitor: tachycardia, narrow pulse pressure, CVP above 15 mmHg (instructor-assessed)",
    { "text": "Start CPR within 10 s of the pulse loss", "rule": { "kind": "eventWithin", "after": "pulseLoss", "event": "cpr", "withinS": 10 } },
    { "text": "Pericardiocentesis within 120 s of starting CPR", "rule": { "kind": "eventWithin", "after": "cpr", "event": "state:cprDrained", "withinS": 120 } },
    { "text": "Stop CPR (“Pulse back”) within 30 s of the pulse returning on the arterial line and the capnogram", "rule": { "kind": "eventWithin", "after": "rosc", "event": "state:rosc", "withinS": 30 } },
    { "text": "Better: pericardiocentesis before the pulse loss, while the systolic pressure is above 60 mmHg — then no PEA follows", "rule": { "kind": "never", "event": "pulseLoss" } }
  ],
  "notes": "Showcase case (Stage 11). MODELED: the physiology produces every change; the buttons only give what their label says. Measured course and bands: docs/plans/stage-11-scenarios.md.",
  "seed": 7,
  "mode": "modeled",
  "patient": {
    "ageY": 30,
    "sex": "M",
    "weightKg": 80,
    "heightCm": 180,
    "ageBand": "adult",
    "sensors": {
      "ecg": "on",
      "spo2": "on",
      "nibp": "on",
      "abp": "connected",
      "co2": "on",
      "temp": "on",
      "cvp": "connected"
    }
  },
  "initialState": "arrival",
  "states": [
    {
      "id": "arrival",
      "label": "Arrival: tachycardic, narrow pulse pressure, raised CVP",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "ventilation",
            "source": "spontaneous",
            "fio2": 0.5
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "condition",
            "id": "tamponade",
            "severity": 1,
            "volumeMl": 250,
            "rateMlPerMin": 15
          }
        }
      ],
      "transitions": [
        {
          "id": "drain",
          "label": "Pericardiocentesis",
          "to": "drainedEarly",
          "when": {
            "manual": {
              "label": "Pericardiocentesis"
            }
          }
        },
        {
          "id": "propofol",
          "label": "Induce for intubation: propofol 2 mg/kg",
          "to": "propofol",
          "when": {
            "manual": {
              "label": "Induce for intubation: propofol 2 mg/kg"
            }
          }
        },
        {
          "id": "worse",
          "label": "Systolic below 80",
          "to": "deteriorating",
          "when": {
            "vital": {
              "var": "sbp",
              "op": "<",
              "value": 80,
              "forS": 5
            }
          }
        }
      ]
    },
    {
      "id": "deteriorating",
      "label": "Deteriorating: systolic below 80",
      "transitions": [
        {
          "id": "drain-deteriorating",
          "label": "Pericardiocentesis",
          "to": "drainedEarly",
          "when": {
            "manual": {
              "label": "Pericardiocentesis"
            }
          }
        },
        {
          "id": "propofol-deteriorating",
          "label": "Induce for intubation: propofol 2 mg/kg",
          "to": "propofol",
          "when": {
            "manual": {
              "label": "Induce for intubation: propofol 2 mg/kg"
            }
          }
        },
        {
          "id": "loss",
          "label": "No pulse (PEA)",
          "to": "pea",
          "when": {
            "vital": {
              "var": "sbp",
              "op": "<",
              "value": 25,
              "forS": 10
            }
          }
        }
      ]
    },
    {
      "id": "propofol",
      "label": "Propofol 2 mg/kg given: compensation lost",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "drug",
            "drugId": "propofol",
            "dose": 2,
            "unit": "mg/kg",
            "route": "iv"
          }
        }
      ],
      "transitions": [
        {
          "id": "drain-propofol",
          "label": "Pericardiocentesis",
          "to": "drainedEarly",
          "when": {
            "manual": {
              "label": "Pericardiocentesis"
            }
          }
        },
        {
          "id": "loss-propofol",
          "label": "No pulse (PEA)",
          "to": "peaAfterPropofol",
          "when": {
            "vital": {
              "var": "sbp",
              "op": "<",
              "value": 25,
              "forS": 10
            }
          }
        }
      ]
    },
    {
      "id": "pea",
      "label": "PEA: organised rhythm, no pulse; the pericardium holds about 370 mL",
      "notes": "With no cardiac output the wound stops bleeding: the accumulation stops at the pulse loss (370 mL).",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "condition",
            "id": "tamponade",
            "severity": 1,
            "volumeMl": 370,
            "rateMlPerMin": 0
          }
        }
      ],
      "transitions": [
        {
          "id": "cpr",
          "label": "Start CPR, intubate, FiO₂ 1.0",
          "to": "cpr",
          "when": {
            "manual": {
              "label": "Start CPR, intubate, FiO₂ 1.0"
            }
          }
        }
      ]
    },
    {
      "id": "peaAfterPropofol",
      "label": "PEA after propofol: organised rhythm, no pulse",
      "transitions": [
        {
          "id": "cpr-peaAfterPropofol",
          "label": "Start CPR, intubate, FiO₂ 1.0",
          "to": "cpr",
          "when": {
            "manual": {
              "label": "Start CPR, intubate, FiO₂ 1.0"
            }
          }
        }
      ]
    },
    {
      "id": "cpr",
