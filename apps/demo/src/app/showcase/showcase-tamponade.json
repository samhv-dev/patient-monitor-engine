          "event": {
            "kind": "cpr",
            "active": true,
            "rate": 110,
            "quality": 0.8
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "airwayDevice",
            "device": "ett"
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "ventilation",
            "source": "ventilator",
            "rr": 12,
            "vtMl": 500,
            "peep": 5,
            "fio2": 1
          }
        }
      ],
      "transitions": [
        {
          "id": "drain-cpr",
          "label": "Pericardiocentesis during CPR",
          "to": "cprDrained",
          "when": {
            "manual": {
              "label": "Pericardiocentesis during CPR"
            }
          }
        },
        {
          "id": "epi",
          "label": "Epinephrine 1 mg",
          "to": "cprEpi",
          "when": {
            "manual": {
              "label": "Epinephrine 1 mg"
            }
          }
        }
      ]
    },
    {
      "id": "cprEpi",
      "label": "CPR: epinephrine 1 mg given",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "drug",
            "drugId": "epinephrine",
            "dose": 1,
            "unit": "mg",
            "route": "iv"
          }
        }
      ],
      "transitions": [
        {
          "id": "drain-cprEpi",
          "label": "Pericardiocentesis during CPR",
          "to": "cprDrained",
          "when": {
            "manual": {
              "label": "Pericardiocentesis during CPR"
            }
          }
        },
        {
          "id": "epi-cprEpi",
          "label": "Epinephrine 1 mg",
          "to": "cprEpiRepeat",
          "when": {
            "manual": {
              "label": "Epinephrine 1 mg"
            }
          }
        }
      ]
    },
    {
      "id": "cprEpiRepeat",
      "label": "CPR: epinephrine 1 mg repeated",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "drug",
            "drugId": "epinephrine",
            "dose": 1,
            "unit": "mg",
            "route": "iv"
          }
        }
      ],
      "transitions": [
        {
          "id": "drain-cprEpiRepeat",
          "label": "Pericardiocentesis during CPR",
          "to": "cprDrained",
          "when": {
            "manual": {
              "label": "Pericardiocentesis during CPR"
            }
          }
        },
        {
          "id": "epi-cprEpiRepeat",
          "label": "Epinephrine 1 mg",
          "to": "cprEpi",
          "when": {
            "manual": {
              "label": "Epinephrine 1 mg"
            }
          }
