{
  "schema": "pme-scenario/1",
  "id": "showcase-mh",
  "title": "Malignant hyperthermia",
  "category": "Showcase",
  "durationMin": 40,
  "story": "A fit 35-year-old man, induced with propofol and succinylcholine and maintained on sevoflurane 2 %. The jaw is stiff after the succinylcholine. Minutes into surgery the EtCO₂ climbs at the same ventilation and the heart rate rises; untreated, the core temperature passes 38.5 °C about 19 minutes after induction and he arrests in VF at 42 °C about 45 minutes after induction. Run the MH crisis: trigger off, oxygen, hyperventilation, dantrolene, cooling and the potassium.",
  "objectives": [
    { "text": "Call the MH crisis (stop sevoflurane, O₂ 100 % at 10 L/min, hyperventilate) within 120 s of the early signs (EtCO₂ above 45 mmHg at the same ventilation)", "rule": { "kind": "eventWithin", "after": "state:earlySigns", "event": "state:triggerOff", "withinS": 120 } },
    { "text": "Give dantrolene 2.5 mg/kg within 300 s of calling the crisis", "rule": { "kind": "eventWithin", "after": "state:triggerOff", "event": "drug:dantrolene", "withinS": 300 } },
    "Repeat dantrolene 2.5 mg/kg within 600 s of the first dose while EtCO₂ is still above 45 mmHg",
    { "text": "Treat the potassium (calcium chloride, insulin with dextrose) within 300 s of K⁺ rising above 5.5 mmol/L", "rule": { "kind": "eventWithin", "after": "value:k>5.5", "event": ["drug:calciumChloride", "drug:insulinDextrose"], "withinS": 300 } },
    { "text": "Bring the ventilation back to 12 × 500 within 300 s of EtCO₂ falling below 40 mmHg", "rule": { "kind": "eventWithin", "from": "state:triggerOff", "after": "value:etco2<40", "event": "state:normoventilated", "withinS": 300 } }
  ],
  "notes": "Showcase case (Stage 11). MODELED: the physiology produces every change; the buttons only give what their label says. Measured course and bands: docs/plans/stage-11-scenarios.md.",
  "seed": 7,
  "mode": "modeled",
  "patient": {
    "ageY": 35,
    "sex": "M",
    "weightKg": 80,
    "heightCm": 180,
    "ageBand": "adult",
    "sensors": {
      "ecg": "on",
      "spo2": "on",
      "nibp": "on",
      "abp": "connected",
      "co2": "on",
      "temp": "on"
    }
  },
  "initialState": "induction",
