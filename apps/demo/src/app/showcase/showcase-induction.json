{
  "schema": "pme-scenario/1",
  "id": "showcase-induction",
  "title": "Healthy induction",
  "category": "Showcase",
  "durationMin": 10,
  "story": "A fit 40-year-old man for elective surgery. Induce with propofol and rocuronium, watch the pressure fall and the breathing stop, then intubate and ventilate.",
  "objectives": [
    "Anticipate the fall in arterial pressure after propofol",
    "Recognise apnoea and falling SpO₂ before intubation",
    "Confirm ventilation with the capnogram"
  ],
  "notes": "Showcase case (Stage 9 Task 26). MODELED: the physiology produces every change.",
  "seed": 7,
  "mode": "modeled",
  "patient": {
    "ageY": 40,
    "sex": "M",
    "weightKg": 75,
    "heightCm": 178,
    "ageBand": "adult",
    "sensors": {
      "ecg": "on",
      "spo2": "on",
      "nibp": "on",
      "abp": "connected",
      "co2": "on",
      "temp": "on"
    }
  },
  "initialState": "awake",
  "states": [
    {
      "id": "awake",
      "label": "Awake, preoxygenated",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "preoxygenate",
            "fio2": 1,
            "durationS": 180
          }
        }
      ],
      "transitions": [
        {
          "id": "induce",
          "label": "Induce now",
          "to": "induced",
          "when": {
            "manual": {
              "label": "Induce now"
            }
          }
        }
      ]
    },
    {
      "id": "induced",
      "label": "Induced: propofol 2 mg/kg, rocuronium 0.6 mg/kg",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "drug",
            "drugId": "propofol",
            "dose": 2,
            "unit": "mg/kg",
            "route": "iv"
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "drug",
            "drugId": "rocuronium",
            "dose": 0.6,
            "unit": "mg/kg",
            "route": "iv"
          }
        }
      ],
      "transitions": [
        {
          "id": "intubate",
          "label": "Intubate and ventilate",
          "to": "ventilated",
          "when": {
            "manual": {
              "label": "Intubate and ventilate"
            }
          }
        }
      ]
    },
    {
      "id": "ventilated",
      "label": "Intubated and ventilated",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "airwayDevice",
            "device": "ett"
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "ventilation",
            "source": "ventilator",
            "rr": 12,
            "vtMl": 500,
            "peep": 5,
            "fio2": 0.5
          }
        }
      ]
    }
  ]
}
