{
  "schema": "pme-scenario/1",
  "id": "showcase-haemorrhage",
  "title": "Class IV haemorrhage, PEA and resuscitation",
  "category": "Showcase",
  "durationMin": 25,
  "story": "A 35-year-old man bleeding 2.5 L over 10 minutes, breathing room air: oxygen and the ventilator come only from your steps. Intubated and ventilated, he loses his pulse at about 10½ minutes on a junctional rhythm (PEA), which, left untreated, slows into asystole about 5 minutes later. Start CPR with ventilation and give 2 L of warmed crystalloid and 2 units of red cells: at the first pulse check he is in VF. Shock it; at the second pulse check VF is back; the second shock leaves an organised rhythm and the pulse returns about a minute later.",
  "objectives": [
    "Recognise PEA from hypovolaemia",
    { "text": "Start high-quality CPR without delay (debrief: within 30 s of the pulse loss — draft, owner to confirm)", "rule": { "kind": "eventWithin", "after": "pulseLoss", "event": "cpr", "withinS": 30 } },
    { "text": "Give volume and epinephrine; recognise the return of circulation on the arterial line and capnogram (debrief: the pulse back within 6 min of its loss — draft, owner to confirm)", "rule": { "kind": "eventWithin", "after": "pulseLoss", "event": "rosc", "withinS": 360 } }
  ],
  "notes": "Showcase case (Stage 9 Task 26; the course E120, 2026-10-24). MODELED. Oxygen is never implicit (E121): room air until Oxygen by face mask or Intubate and ventilate; ventilation during CPR is the CPR step itself (bag via the tube). Without the ventilator step he compensates (systolic about 76 at 10 min) and does not arrest. THE CARD SETS THE RHYTHM three times: the junctional rhythm 50/min (when the systolic stays below 60 for 10 s, or its button) and VF at the first and at the second pulse check. Everything else is the physiology: the pulse loss, the PEA on the running junctional rhythm, its decay to an idioventricular rhythm and asystole (the seeded hazard), the rise of the coronary perfusion pressure with CPR and volume, each shock's outcome (the defibrillator's outcome table on the engine seed: the first shock ends VF in asystole, the second in an organised rhythm) and the pulse returning once the perfusion pressure (at least 15 mmHg) and the myocardium have held for 60 s. Measured course: the E120 rows of docs/showcase/SHOWCASE-2-RUN-SHEET.md.",
  "seed": 7,
  "mode": "modeled",
  "patient": {
    "ageY": 35,
    "sex": "M",
    "weightKg": 75,
    "heightCm": 178,
    "ageBand": "adult",
    "sensors": {
      "ecg": "on",
      "spo2": "on",
      "nibp": "on",
      "abp": "connected",
      "co2": "on",
      "temp": "on"
    }
  },
  "initialState": "bleeding",
  "states": [
    {
      "id": "bleeding",
      "label": "Bleeding 2.5 L over 10 min, breathing room air",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "bleed",
            "volumeMl": 2500,
            "overS": 600
          }
        }
      ],
      "transitions": [
        {
          "id": "oxygen",
          "label": "Oxygen by face mask, FiO₂ 1.0",
          "to": "bleedingO2",
          "when": {
            "manual": {
              "label": "Oxygen by face mask, FiO₂ 1.0"
            }
          }
        },
        {
          "id": "intubate",
          "label": "Intubate and ventilate, FiO₂ 1.0",
          "to": "ventilated",
          "when": {
            "manual": {
              "label": "Intubate and ventilate, FiO₂ 1.0"
            }
          }
        }
      ]
    },
    {
      "id": "bleedingO2",
      "label": "Bleeding, oxygen by face mask (FiO₂ 1.0)",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "preoxygenate",
            "fio2": 1,
            "durationS": 3600
          }
        }
      ],
      "transitions": [
        {
          "id": "intubate-o2",
          "label": "Intubate and ventilate, FiO₂ 1.0",
          "to": "ventilated",
          "when": {
            "manual": {
              "label": "Intubate and ventilate, FiO₂ 1.0"
            }
          }
        }
      ]
    },
    {
      "id": "ventilated",
      "label": "Bleeding, intubated and ventilated (12 × 500, PEEP 5, FiO₂ 1.0)",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "airwayDevice",
            "device": "ett"
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "preoxygenate",
            "fio2": 0.21,
            "durationS": 1
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "ventilation",
            "source": "ventilator",
            "rr": 12,
            "vtMl": 500,
            "peep": 5,
            "fio2": 1
          }
        }
      ],
      "transitions": [
        {
          "id": "junctional",
          "label": "Pre-arrest: junctional rhythm",
          "to": "junctional",
          "when": {
            "any": [
              {
                "manual": {
                  "label": "Pre-arrest: junctional rhythm"
                }
              },
              {
                "vital": {
                  "var": "sbp",
                  "op": "<",
                  "value": 60,
                  "forS": 10
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "junctional",
      "label": "Pre-arrest: junctional rhythm 50/min",
      "onEnter": [
        {
          "type": "setRhythm",
          "rhythm": "junctionalEscape",
          "opts": {
            "rateBpm": 50
          },
          "when": "nextBeat"
        }
      ],
      "transitions": [
        {
          "id": "pea",
          "label": "No pulse",
          "to": "pea",
          "when": {
            "vital": {
              "var": "sbp",
              "op": "<",
              "value": 25,
              "forS": 10
            }
          }
        }
      ],
      "notes": "The card sets the rhythm: a junctional rhythm at 50/min (an instructor rhythm event, not the physiology). The pulse loss that follows is the model's."
    },
    {
      "id": "pea",
      "label": "PEA: junctional rhythm, no pulse",
      "transitions": [
        {
          "id": "asystole",
          "label": "Asystole",
          "to": "asystole",
          "when": {
            "vital": {
              "var": "hr",
              "op": "<",
              "value": 1,
              "forS": 5
            }
          }
        },
        {
          "id": "cpr-pea",
          "label": "Start CPR: compressions, bag via the tube 10/min, FiO₂ 1.0",
          "to": "cpr",
          "when": {
            "manual": {
              "label": "Start CPR: compressions, bag via the tube 10/min, FiO₂ 1.0"
            }
          }
        }
      ],
      "notes": "The model's PEA on the running junctional rhythm. On the owner's course it is left untreated: it slows, becomes idioventricular and turns to asystole about 5 minutes after the pulse loss."
    },
    {
      "id": "asystole",
      "label": "Asystole",
      "transitions": [
        {
          "id": "cpr",
          "label": "Start CPR: compressions, bag via the tube 10/min, FiO₂ 1.0",
          "to": "cpr",
          "when": {
            "manual": {
              "label": "Start CPR: compressions, bag via the tube 10/min, FiO₂ 1.0"
            }
          }
        }
      ]
    },
    {
      "id": "cpr",
      "label": "CPR: compressions 110/min, bag via the tube 10/min, FiO₂ 1.0",
      "onEnter": [
        {
          "type": "applyEvent",
          "event": {
            "kind": "cpr",
            "active": true,
            "rate": 110,
            "quality": 0.8
          }
        },
        {
          "type": "applyEvent",
          "event": {
            "kind": "ventilation",
            "source": "bvm",
            "rr": 10,
            "vtMl": 500,
            "fio2": 1
          }
        }
      ],
      "transitions": [
        {
          "id": "volume",
          "label": "2 L warmed crystalloid and 2 units of red cells",
          "to": "cprVolume",
          "when": {
            "manual": {
              "label": "2 L warmed crystalloid and 2 units of red cells"
            }
          }
        },
        {
          "id": "epi",
          "label": "Epinephrine 1 mg",
          "to": "cprEpi",
          "when": {
            "manual": {
              "label": "Epinephrine 1 mg"
            }
          }
        },
        {
          "id": "pulseCheck1",
          "label": "Pulse check",
          "to": "vf",
          "when": {
            "manual": {
              "label": "Pulse check"
            }
          }
        },
        {
          "id": "stop-cpr",
          "label": "Pulse back: stop CPR",
          "to": "rosc",
          "when": {
            "manual": {
              "label": "Pulse back: stop CPR"
            }
          }
        }
      ]
    },
    {
      "id": "cprVolume",
      "label": "CPR: 2 L warmed crystalloid and 2 units of red cells running",
