+      [t0, ev({ kind: 'bleed', volumeMl: 4000, overS: 2400 })],
+      [t0, ev({ kind: 'transfusion', product: 'rbc', units: 10, overS: 2400, storageDays: 35, warmed: false })],
+      [t0, ev({ kind: 'transfusion', product: 'ffp', units: 10, overS: 2400, warmed: true })],
